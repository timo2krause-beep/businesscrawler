# Database
DATABASE_URL=postgresql://scraper:scraper@localhost:5433/scraper

# Auth
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRE_MINUTES=10080

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# GitHub API (optional, erhöht Rate Limit)
GITHUB_TOKEN=

# --- Social Login (OAuth2) ---
# Ein Provider wird im Frontend nur als Button angezeigt, wenn seine
# Credentials hier gesetzt sind (siehe GET /auth/oauth/providers).

# Google: https://console.cloud.google.com/apis/credentials
# Redirect-URI eintragen: {BACKEND_URL}/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft (Azure AD / Entra ID App-Registrierung): https://portal.azure.com
# Redirect-URI: {BACKEND_URL}/auth/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Facebook: https://developers.facebook.com/apps
# Redirect-URI: {BACKEND_URL}/auth/oauth/facebook/callback
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# GitHub OAuth App (nicht zu verwechseln mit GITHUB_TOKEN oben):
# https://github.com/settings/developers
# Redirect-URI: {BACKEND_URL}/auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Apple "Sign in with Apple" – benötigt kostenpflichtige Apple-Developer-Mitgliedschaft.
# https://developer.apple.com/account/resources/identifiers
# Redirect-URI: {BACKEND_URL}/auth/oauth/apple/callback
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# SMTP für E-Mail Reports
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com

LOG_LEVEL=INFO

# OpenRouter AI (für KI-Wettbewerbsanalyse)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Places API (für Google Reviews)
GOOGLE_PLACES_API_KEY=
